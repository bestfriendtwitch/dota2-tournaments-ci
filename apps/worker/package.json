{
  "name": "@dota-liga/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --platform node --out-dir dist --clean",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:integration": "tsx --test --test-concurrency=1 src/*.integration.test.ts"
  },
  "dependencies": {
    "@dota-liga/config": "workspace:*",
    "@dota-liga/database": "workspace:*",
    "bullmq": "^5.81.2",
    "ioredis": "^5.7.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
